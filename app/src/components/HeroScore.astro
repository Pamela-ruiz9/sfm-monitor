---
import { loadSfmData } from '~/data/loader';
import { computeAlerts } from '~/data/alerts';
import { computeScore } from '~/data/score';

const data = loadSfmData();
const alerts = computeAlerts(data);
const score = computeScore(data);

// Format periodo 'YYYY-MM' → 'mar 2026'
const MESES = ['ene', 'feb', 'mar', 'abr', 'may', 'jun', 'jul', 'ago', 'sep', 'oct', 'nov', 'dic'];
function formatPeriodo(periodo: string): string {
  const parts = periodo.split('-');
  const year = parts[0] ?? '';
  const monthRaw = parts[1] ?? '';
  const monthIdx = parseInt(monthRaw, 10) - 1;
  const monthLabel = MESES[monthIdx] ?? monthRaw;
  return `${monthLabel} ${year}`;
}

const periodoLabel = formatPeriodo(score.periodo);

function barWidth(val: number): number {
  return Math.min(Math.round(val * 100), 100);
}
---

<section class="space-y-3">
  <div class="text-[10px] font-semibold uppercase tracking-[0.18em] text-(--color-gold)">
    Score Global del Sistema
  </div>

  <h1
    class="serif font-semibold leading-[1.05] tracking-tight"
    style={`font-size: clamp(2.8rem, 6vw, 4.8rem); color: ${score.color}`}>
    {score.label}
    <span
      class="text-(--color-text-mute) font-normal"
      style="font-size: clamp(1rem, 2.5vw, 1.4rem)">
      [{periodoLabel}]
    </span>
  </h1>

  <!-- Sub-index progress bars -->
  <div class="space-y-2 pt-1 max-w-sm">
    <!-- Credito -->
    <div class="flex items-center gap-3">
      <span class="text-xs text-(--color-text-dim) w-24 shrink-0">Credito</span>
      <div class="flex-1 h-2 rounded-full bg-(--color-border-soft) overflow-hidden">
        <div
          class="h-full rounded-full"
          style={`width: ${barWidth(score.subindices.credito)}%; background: ${score.color}`}>
        </div>
      </div>
      <span class="text-xs text-(--color-text-mute) w-8 text-right tabular-nums">
        {score.subindices.credito.toFixed(2)}
      </span>
    </div>

    <!-- Rentabilidad -->
    <div class="flex items-center gap-3">
      <span class="text-xs text-(--color-text-dim) w-24 shrink-0">Rentabilidad</span>
      <div class="flex-1 h-2 rounded-full bg-(--color-border-soft) overflow-hidden">
        <div
          class="h-full rounded-full"
          style={`width: ${barWidth(score.subindices.rentabilidad)}%; background: ${score.color}`}>
        </div>
      </div>
      <span class="text-xs text-(--color-text-mute) w-8 text-right tabular-nums">
        {score.subindices.rentabilidad.toFixed(2)}
      </span>
    </div>

    <!-- Macro -->
    <div class="flex items-center gap-3">
      <span class="text-xs text-(--color-text-dim) w-24 shrink-0">Macro</span>
      <div class="flex-1 h-2 rounded-full bg-(--color-border-soft) overflow-hidden">
        <div
          class="h-full rounded-full"
          style={`width: ${barWidth(score.subindices.macro)}%; background: ${score.color}`}>
        </div>
      </div>
      <span class="text-xs text-(--color-text-mute) w-8 text-right tabular-nums">
        {score.subindices.macro.toFixed(2)}
      </span>
    </div>
  </div>

  <!-- Numeric score -->
  <p class="text-xs text-(--color-text-mute) tabular-nums">
    Score: {score.value.toFixed(2)} / 1.00
  </p>

  <!-- Alerts and methodology link -->
  <div class="flex flex-wrap items-center gap-x-4 gap-y-1">
    {
      alerts.length > 0 && (
        <p class="text-[11px] text-(--color-text-mute)">
          {alerts.length} {alerts.length === 1 ? 'alerta activa' : 'alertas activas'} — ver panel debajo.
        </p>
      )
    }
    <a
      href="/metodologia#score-global"
      class="text-[11px] text-(--color-accent) hover:underline">
      &#x2197; Metodologia
    </a>
  </div>
</section>
