---
interface Props {
  variant?: 'horizontal' | 'stacked' | 'icon';
  showSubtitle?: boolean;
  size?: 'sm' | 'md' | 'lg';
  class?: string;
}

const {
  variant = 'horizontal',
  showSubtitle = false,
  size = 'md',
  class: className = '',
} = Astro.props;

const iconSize = { sm: 20, md: 28, lg: 40 }[size];
const wordmarkSize = { sm: 'text-sm', md: 'text-lg', lg: 'text-2xl' }[size];
---

<div
  class:list={[
    'sfm-logo',
    `sfm-logo--${variant}`,
    `sfm-logo--${size}`,
    className,
  ]}
  style="color: var(--color-accent);">

  <!-- Símbolo SVG inline — usa currentColor para recolorear vía CSS -->
  <svg
    viewBox="0 0 56 56"
    width={iconSize}
    height={iconSize}
    aria-hidden="true"
    class="sfm-logo__icon shrink-0">
    <!-- Anillo dial abierto (32% opacidad del acento) -->
    <circle
      cx="28"
      cy="28"
      r="22"
      fill="none"
      stroke="currentColor"
      stroke-opacity="0.32"
      stroke-width="2.4"
      stroke-dasharray="104 34"
      stroke-dashoffset="-17"
      stroke-linecap="round"
    />
    <!-- Pulso ECG -->
    <path
      d="M9 28 H18 L21.5 19.5 L26.5 37.5 L30 24 L32.5 28 H47"
      fill="none"
      stroke="currentColor"
      stroke-width="3.2"
      stroke-linecap="round"
      stroke-linejoin="round"
    />
    <!-- Punto "en vivo" -->
    <circle cx="47" cy="28" r="2.3" fill="currentColor" />
  </svg>

  {variant !== 'icon' && (
    <div class="sfm-logo__text flex flex-col justify-center">
      <span
        class:list={['sfm-logo__wordmark font-bold leading-none', wordmarkSize]}
        style="font-family: var(--font-logo); letter-spacing: -0.01em; color: var(--color-text);">
        SFM
      </span>
      {showSubtitle && (
        <span
          class="sfm-logo__sub uppercase leading-none mt-0.5"
          style="font-family: var(--font-data); font-size: 8.5px; letter-spacing: 0.24em; color: var(--color-text-mute);">
          Sistema Financiero Mexicano · Monitor
        </span>
      )}
    </div>
  )}
</div>

<style>
  .sfm-logo {
    display: inline-flex;
    align-items: center;
  }
  .sfm-logo--horizontal {
    flex-direction: row;
    gap: 10px;
  }
  .sfm-logo--stacked {
    flex-direction: column;
    gap: 6px;
    align-items: center;
  }
  .sfm-logo--stacked .sfm-logo__text {
    align-items: center;
  }
  .sfm-logo--icon {
    flex-direction: row;
  }
</style>
