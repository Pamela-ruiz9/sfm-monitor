---
import Layout from '~/layouts/Layout.astro';
import Header from '~/components/shell/Header.astro';
import BottomNav from '~/components/shell/BottomNav.astro';
import EditorialHeadline from '~/components/chrome/EditorialHeadline.astro';
import CitationBox from '~/components/CitationBox.astro';
import { ChartDrawer } from '~/components/drawer/ChartDrawer';
import { CmdKPalette } from '~/components/shell/CmdKPalette';
import { UpdateToast } from '~/components/shell/UpdateToast';
import { PWAInstallPrompt } from '~/components/shell/PWAInstallPrompt';
import { OnboardingTour } from '~/components/shell/OnboardingTour';
import { SwipeNav } from '~/components/shell/SwipeNav';
import { PullToRefresh } from '~/components/shell/PullToRefresh';

const SEMAFORO_DOT = {
  green: 'bg-(--color-green)',
  yellow: 'bg-(--color-yellow)',
  red: 'bg-(--color-red)',
};
---

<Layout
  title="Metodología"
  description="Notas metodológicas: cómo se calculan los semáforos del SFM Monitor, fuentes de datos, frecuencia de actualización.">
  <Header slot="header" />

  <div class="space-y-8 max-w-3xl">
    <EditorialHeadline
      eyebrow="Metodología"
      headline="Cómo se construyen los indicadores y semáforos del SFM Monitor."
    />

    <!-- Sobre el proyecto -->
    <section class="space-y-4 pb-8 border-b border-(--color-border-soft)">
      <div class="text-[10px] font-semibold uppercase tracking-[0.18em] text-(--color-accent)">
        Sobre el proyecto
      </div>
      <h2 class="serif font-semibold text-3xl text-(--color-text) leading-tight">
        SFM Monitor
      </h2>
      <p class="text-sm text-(--color-text-dim) leading-relaxed max-w-2xl">
        Dashboard público y citable de indicadores de riesgo del Sistema Financiero Mexicano.
        Consolida en un solo lugar las métricas de crédito (IMOR, IMORA, ICOR, IFRS 9),
        mercado (FX, TIIE), macro (inflación, PIB) y liquidez (reservas internacionales),
        con datos actualizados diariamente desde fuentes oficiales.
      </p>
      <p class="text-sm text-(--color-text-dim) leading-relaxed max-w-2xl">
        Dirigido a analistas financieros, investigadores, periodistas económicos y cualquier
        persona interesada en monitorear la salud del sistema bancario mexicano con información
        abierta y citable.
      </p>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-2">
        <div class="space-y-1">
          <div class="text-[10px] font-semibold uppercase tracking-[0.12em] text-(--color-text-mute)">Autora principal</div>
          <div class="text-sm text-(--color-text)">Ingrid Pamela Ruiz Puga</div>
          <div class="text-[12px] text-(--color-text-mute)">BBVA México · Científica de datos</div>
        </div>
        <div class="space-y-1">
          <div class="text-[10px] font-semibold uppercase tracking-[0.12em] text-(--color-text-mute)">Co-autoría</div>
          <div class="text-sm text-(--color-text)">Artemio Padilla</div>
          <div class="text-[12px] text-(--color-text-mute)">Blueprint 2026 · Migración Astro</div>
        </div>
      </div>
      <div class="flex flex-wrap gap-x-6 gap-y-1 pt-1">
        <span class="text-[12px] text-(--color-text-mute)">
          Código: <a href="https://github.com/Pamela-ruiz9/sfm-monitor/blob/main/LICENSE" target="_blank" rel="noopener" class="text-(--color-accent) hover:underline">MIT</a>
        </span>
        <span class="text-[12px] text-(--color-text-mute)">
          Contenido: <a href="https://github.com/Pamela-ruiz9/sfm-monitor/blob/main/LICENSE-CONTENT" target="_blank" rel="noopener" class="text-(--color-accent) hover:underline">CC-BY 4.0</a>
        </span>
        <span class="text-[12px] text-(--color-text-mute)">
          DOI: <a href="https://doi.org/10.5281/zenodo.20370914" target="_blank" rel="noopener" class="text-(--color-accent) hover:underline">10.5281/zenodo.20370914</a>
        </span>
      </div>
    </section>

    <!-- Noticias & Impacto -->
    <details class="card-surface p-5 group">
      <summary class="cursor-pointer text-base font-semibold text-(--color-text) flex items-center justify-between">
        Noticias & Impacto — metodología del feed
        <span class="text-(--color-text-mute) group-open:rotate-180 transition-transform">▾</span>
      </summary>
      <div class="mt-4 space-y-5">

        <p class="text-sm text-(--color-text-dim) leading-relaxed">
          La sección <strong class="text-(--color-text)">Noticias & Impacto</strong> en
          <code>/macro/noticias</code> consume la
          <a href="https://watchboard.dev/api/" target="_blank" rel="noopener noreferrer" class="text-(--color-accent) hover:underline">API pública de Watchboard</a>
          — plataforma de inteligencia de eventos globales desarrollada por
          <strong class="text-(--color-text)">Artemio Padilla</strong> (co-autor del blueprint 2026).
          API gratuita, sin autenticación, CORS abierto, caché CDN de 1 hora.
        </p>

        <!-- Trackers -->
        <div class="space-y-2">
          <div class="text-[10px] font-semibold uppercase tracking-[0.12em] text-(--color-text-mute)">Trackers monitoreados</div>
          <div class="overflow-x-auto">
            <table class="w-full border-collapse text-xs text-(--color-text-dim)">
              <thead>
                <tr class="border-b border-(--color-border)">
                  <th class="text-left py-1.5 pr-4 font-semibold text-(--color-text-mute)">Tracker</th>
                  <th class="text-left py-1.5 pr-4 font-semibold text-(--color-text-mute)">Foco</th>
                  <th class="text-left py-1.5 font-semibold text-(--color-text-mute)">Categoría SFM</th>
                </tr>
              </thead>
              <tbody>
                <tr class="border-b border-(--color-border-soft)"><td class="py-1.5 pr-4 font-mono text-(--color-text)">global-recession-risk</td><td class="py-1.5 pr-4">Fed, tasas, aranceles, PMI global</td><td class="py-1.5">Política monetaria / Externa</td></tr>
                <tr class="border-b border-(--color-border-soft)"><td class="py-1.5 pr-4 font-mono text-(--color-text)">sheinbaum-presidency</td><td class="py-1.5 pr-4">Política económica México (FDI, USMCA, fiscal)</td><td class="py-1.5">Fiscal</td></tr>
                <tr class="border-b border-(--color-border-soft)"><td class="py-1.5 pr-4 font-mono text-(--color-text)">trump-presidencies</td><td class="py-1.5 pr-4">Aranceles EE.UU., política comercial</td><td class="py-1.5">Externa</td></tr>
                <tr><td class="py-1.5 pr-4 font-mono text-(--color-text)">mexico</td><td class="py-1.5 pr-4">Macro México (Pemex, deuda, precios)</td><td class="py-1.5">Sistémica</td></tr>
              </tbody>
            </table>
          </div>
        </div>

        <!-- Metodología de reglas -->
        <div class="space-y-2">
          <div class="text-[10px] font-semibold uppercase tracking-[0.12em] text-(--color-text-mute)">Metodología de reglas de impacto</div>
          <p class="text-sm text-(--color-text-dim) leading-relaxed">
            El análisis de impacto es <strong class="text-(--color-text)">estático y determinístico</strong>: cada evento
            pasa por 10 reglas en <code>watchboard-rules.ts</code>. Una regla activa cuando el tracker, el tipo de evento
            y al menos una palabra clave del titular coinciden. Se acumulan todas las reglas activas; en caso de conflicto
            en el mismo eje, gana la primera regla. Sin inteligencia artificial en runtime.
          </p>
        </div>

        <!-- Tabla de 10 reglas -->
        <div class="space-y-2">
          <div class="text-[10px] font-semibold uppercase tracking-[0.12em] text-(--color-text-mute)">Las 10 reglas</div>
          <div class="overflow-x-auto">
            <table class="w-full border-collapse text-xs text-(--color-text-dim)">
              <thead>
                <tr class="border-b border-(--color-border)">
                  <th class="text-left py-1.5 pr-3 font-semibold text-(--color-text-mute) whitespace-nowrap">ID</th>
                  <th class="text-left py-1.5 pr-3 font-semibold text-(--color-text-mute)">Tracker(s)</th>
                  <th class="text-left py-1.5 pr-3 font-semibold text-(--color-text-mute)">Tipo</th>
                  <th class="text-left py-1.5 pr-3 font-semibold text-(--color-text-mute)">Keywords</th>
                  <th class="text-left py-1.5 pr-3 font-semibold text-(--color-text-mute)">Canal de transmisión</th>
                  <th class="text-left py-1.5 font-semibold text-(--color-text-mute) whitespace-nowrap">Ejes SFM</th>
                </tr>
              </thead>
              <tbody>
                <tr class="border-b border-(--color-border-soft) align-top">
                  <td class="py-1.5 pr-3 font-mono text-(--color-text) whitespace-nowrap">R01</td>
                  <td class="py-1.5 pr-3 font-mono">global-recession-risk</td>
                  <td class="py-1.5 pr-3">policy</td>
                  <td class="py-1.5 pr-3">fed, fomc, warsh, tasa, rate</td>
                  <td class="py-1.5 pr-3">Hawkish Fed → TIIE elevada → costo fondeo → IMOR consumo</td>
                  <td class="py-1.5 whitespace-nowrap">Mora ↑ 3-6m<br/>Rent. ↑ inm.</td>
                </tr>
                <tr class="border-b border-(--color-border-soft) align-top">
                  <td class="py-1.5 pr-3 font-mono text-(--color-text)">R02</td>
                  <td class="py-1.5 pr-3 font-mono">global-recession-risk<br/>trump-presidencies</td>
                  <td class="py-1.5 pr-3">trade</td>
                  <td class="py-1.5 pr-3">tariff, arancel, section 122, trade war</td>
                  <td class="py-1.5 pr-3">Aranceles → contracción comercial → FX presión → liquidez empresarial</td>
                  <td class="py-1.5 whitespace-nowrap">Liq. ↓ 3m<br/>Mora ↑ 3-6m</td>
                </tr>
                <tr class="border-b border-(--color-border-soft) align-top">
                  <td class="py-1.5 pr-3 font-mono text-(--color-text)">R03</td>
                  <td class="py-1.5 pr-3 font-mono">global-recession-risk</td>
                  <td class="py-1.5 pr-3">market</td>
                  <td class="py-1.5 pr-3">oil, crude, brent, petróleo</td>
                  <td class="py-1.5 pr-3">Brent bajo → inflación baja → menor presión TIIE → fondeo estable</td>
                  <td class="py-1.5 text-(--color-text-mute) italic">solo cat.</td>
                </tr>
                <tr class="border-b border-(--color-border-soft) align-top">
                  <td class="py-1.5 pr-3 font-mono text-(--color-text)">R04</td>
                  <td class="py-1.5 pr-3 font-mono">global-recession-risk</td>
                  <td class="py-1.5 pr-3">economic</td>
                  <td class="py-1.5 pr-3">recession, gdp, pmi, slowdown</td>
                  <td class="py-1.5 pr-3">Desaceleración global → remesas/exportaciones bajan → IMOR lagging</td>
                  <td class="py-1.5 whitespace-nowrap">Mora ↑ 6-12m<br/>Liq. ↓ 6m</td>
                </tr>
                <tr class="border-b border-(--color-border-soft) align-top">
                  <td class="py-1.5 pr-3 font-mono text-(--color-text)">R05</td>
                  <td class="py-1.5 pr-3 font-mono">sheinbaum-presidency</td>
                  <td class="py-1.5 pr-3">economic</td>
                  <td class="py-1.5 pr-3">fdi, ied, inversión, nearshoring</td>
                  <td class="py-1.5 pr-3">IED récord → flujos capital → FX estable → fondeo barato</td>
                  <td class="py-1.5 whitespace-nowrap">Liq. ↑ 3m</td>
                </tr>
                <tr class="border-b border-(--color-border-soft) align-top">
                  <td class="py-1.5 pr-3 font-mono text-(--color-text)">R06</td>
                  <td class="py-1.5 pr-3 font-mono">sheinbaum-presidency<br/>trump-presidencies</td>
                  <td class="py-1.5 pr-3">trade, economic</td>
                  <td class="py-1.5 pr-3">usmca, renegociación, mexico tariff</td>
                  <td class="py-1.5 pr-3">Incertidumbre USMCA → riesgo exportador → IMOR empresarial</td>
                  <td class="py-1.5 whitespace-nowrap">Mora ↑ 6m<br/>Liq. ↓ 3m</td>
                </tr>
                <tr class="border-b border-(--color-border-soft) align-top">
                  <td class="py-1.5 pr-3 font-mono text-(--color-text)">R07</td>
                  <td class="py-1.5 pr-3 font-mono">sheinbaum-presidency</td>
                  <td class="py-1.5 pr-3">political</td>
                  <td class="py-1.5 pr-3">cnte, huelga, reforma, strike</td>
                  <td class="py-1.5 pr-3">Incertidumbre regulatoria/fiscal → riesgo soberano leve</td>
                  <td class="py-1.5 whitespace-nowrap">Solv. ↓ 6-12m</td>
                </tr>
                <tr class="border-b border-(--color-border-soft) align-top">
                  <td class="py-1.5 pr-3 font-mono text-(--color-text)">R08</td>
                  <td class="py-1.5 pr-3 font-mono">global-recession-risk</td>
                  <td class="py-1.5 pr-3">economic</td>
                  <td class="py-1.5 pr-3">inflation, inflación, pce, cpi, inpc</td>
                  <td class="py-1.5 pr-3">Inflación alta → TIIE no baja → costo crédito consumo</td>
                  <td class="py-1.5 whitespace-nowrap">Mora ↑ 3m<br/>Rent. ↑ inm.</td>
                </tr>
                <tr class="border-b border-(--color-border-soft) align-top">
                  <td class="py-1.5 pr-3 font-mono text-(--color-text)">R09</td>
                  <td class="py-1.5 pr-3 font-mono">mexico</td>
                  <td class="py-1.5 pr-3">economic</td>
                  <td class="py-1.5 pr-3">pemex, deuda, déficit, fiscal</td>
                  <td class="py-1.5 pr-3">Riesgo soberano/cuasi-soberano → spread bancario → solvencia sistémica</td>
                  <td class="py-1.5 whitespace-nowrap">Solv. ↓ 6-12m</td>
                </tr>
                <tr class="align-top">
                  <td class="py-1.5 pr-3 font-mono text-(--color-text)">R10</td>
                  <td class="py-1.5 pr-3 font-mono">sheinbaum-presidency<br/>mexico</td>
                  <td class="py-1.5 pr-3">economic</td>
                  <td class="py-1.5 pr-3">tomate, precio, canasta, salario</td>
                  <td class="py-1.5 pr-3">Presión precios consumo → INPC → expectativas inflación</td>
                  <td class="py-1.5 whitespace-nowrap">Mora ↑ 3m</td>
                </tr>
              </tbody>
            </table>
          </div>
          <p class="text-[11px] text-(--color-text-mute)">
            Rent. = Rentabilidad · Liq. = Liquidez · Solv. = Solvencia · inm. = inmediato · solo cat. = solo categorización, sin chips de impacto
          </p>
        </div>

        <!-- Limitaciones -->
        <div class="space-y-2">
          <div class="text-[10px] font-semibold uppercase tracking-[0.12em] text-(--color-text-mute)">Limitaciones</div>
          <ul class="text-sm text-(--color-text-dim) leading-relaxed list-disc list-inside space-y-1">
            <li>Las reglas capturan el canal de transmisión principal; no modelan escenarios compuestos ni efectos de segunda ronda.</li>
            <li>El horizonte temporal es orientativo, no una proyección cuantitativa.</li>
            <li>El feed muestra los últimos ~30 eventos por tracker; no es un archivo histórico exhaustivo.</li>
            <li>Las imágenes se obtienen de los artículos fuente vía <a href="https://microlink.io" target="_blank" rel="noopener noreferrer" class="text-(--color-accent) hover:underline">Microlink API</a>; pueden fallar si el artículo bloquea scraping.</li>
          </ul>
        </div>

      </div>
    </details>

    <!-- Score Global del Sistema -->
    <details class="card-surface p-5 group" id="score-global">
      <summary class="cursor-pointer text-base font-semibold text-(--color-text) flex items-center justify-between">
        Score Global del Sistema — metodología
        <span class="text-(--color-text-mute) group-open:rotate-180 transition-transform">▾</span>
      </summary>
      <div class="mt-4 space-y-5">

        <p class="text-sm text-(--color-text-dim) leading-relaxed">
          El <strong class="text-(--color-text)">Score Global del SFM Monitor</strong> es un índice compuesto mensual de riesgo sistémico financiero para México. Agrega en un único número las condiciones de crédito, rentabilidad bancaria y entorno macro, permitiendo comparar el nivel de estrés del sistema a través del tiempo. Metodológicamente está inspirado en el
          <strong class="text-(--color-text)">CISS (Composite Indicator of Systemic Stress)</strong> del BCE (Hollo, Kremer &amp; Lo Duca, 2012), adaptado a las series disponibles en las APIs públicas del Banxico y la CNBV para el sistema bancario mexicano.
        </p>

        <!-- Fórmula -->
        <div class="space-y-2">
          <div class="text-[10px] font-semibold uppercase tracking-[0.12em] text-(--color-text-mute)">Fórmula de agregación</div>
          <pre class="text-xs bg-(--color-bg-elev) p-3 rounded-md font-mono overflow-x-auto text-(--color-text-dim)">Score_t = 0.50 × S_crédito + 0.30 × S_rentabilidad + 0.20 × S_macro

S_crédito      = mean(IMOR_norm, IMORA_norm, ICOR_norm)
S_rentabilidad = mean(ROA_norm, ROE_norm)
S_macro        = mean(FX_norm, Inflación_norm, TasaReal_norm)

Donde cada norma ∈ [0, 1]</pre>
        </div>

        <!-- Tabla de KPIs -->
        <div class="space-y-2">
          <div class="text-[10px] font-semibold uppercase tracking-[0.12em] text-(--color-text-mute)">Indicadores y normalización</div>
          <div class="overflow-x-auto">
            <table class="table-auto w-full border-collapse text-xs text-(--color-text-dim)">
              <thead>
                <tr class="border-b border-(--color-border)">
                  <th class="text-left py-1.5 pr-4 font-semibold text-(--color-text-mute)">Indicador</th>
                  <th class="text-left py-1.5 pr-4 font-semibold text-(--color-text-mute)">Subíndice</th>
                  <th class="text-left py-1.5 pr-4 font-semibold text-(--color-text-mute)">Peso global</th>
                  <th class="text-left py-1.5 pr-4 font-semibold text-(--color-text-mute)">Serie</th>
                  <th class="text-left py-1.5 font-semibold text-(--color-text-mute)">Normalización</th>
                </tr>
              </thead>
              <tbody>
                <tr class="border-b border-(--color-border-soft)">
                  <td class="py-1.5 pr-4 text-(--color-text)">IMOR total</td>
                  <td class="py-1.5 pr-4">Crédito</td>
                  <td class="py-1.5 pr-4">~16.7%</td>
                  <td class="py-1.5 pr-4">304 obs (2000–hoy)</td>
                  <td class="py-1.5">Percentil rolling ↑</td>
                </tr>
                <tr class="border-b border-(--color-border-soft)">
                  <td class="py-1.5 pr-4 text-(--color-text)">IMORA total</td>
                  <td class="py-1.5 pr-4">Crédito</td>
                  <td class="py-1.5 pr-4">~16.7%</td>
                  <td class="py-1.5 pr-4">268 obs (2003–hoy)</td>
                  <td class="py-1.5">Percentil rolling ↑</td>
                </tr>
                <tr class="border-b border-(--color-border-soft)">
                  <td class="py-1.5 pr-4 text-(--color-text)">ICOR total</td>
                  <td class="py-1.5 pr-4">Crédito</td>
                  <td class="py-1.5 pr-4">~16.7%</td>
                  <td class="py-1.5 pr-4">304 obs (2000–hoy)</td>
                  <td class="py-1.5">Percentil rolling ↓ (invertido, cap ×20)</td>
                </tr>
                <tr class="border-b border-(--color-border-soft)">
                  <td class="py-1.5 pr-4 text-(--color-text)">ROA</td>
                  <td class="py-1.5 pr-4">Rentabilidad</td>
                  <td class="py-1.5 pr-4">15%</td>
                  <td class="py-1.5 pr-4">279 obs (2003–hoy)</td>
                  <td class="py-1.5">Percentil rolling ↓ (invertido)</td>
                </tr>
                <tr class="border-b border-(--color-border-soft)">
                  <td class="py-1.5 pr-4 text-(--color-text)">ROE</td>
                  <td class="py-1.5 pr-4">Rentabilidad</td>
                  <td class="py-1.5 pr-4">15%</td>
                  <td class="py-1.5 pr-4">292 obs (2001–hoy)</td>
                  <td class="py-1.5">Percentil rolling ↓ (invertido)</td>
                </tr>
                <tr class="border-b border-(--color-border-soft)">
                  <td class="py-1.5 pr-4 text-(--color-text)">Tipo de cambio</td>
                  <td class="py-1.5 pr-4">Macro</td>
                  <td class="py-1.5 pr-4">~6.7%</td>
                  <td class="py-1.5 pr-4">~390 obs (~1994–hoy)</td>
                  <td class="py-1.5">Percentil rolling ↑</td>
                </tr>
                <tr class="border-b border-(--color-border-soft)">
                  <td class="py-1.5 pr-4 text-(--color-text)">Inflación INPC</td>
                  <td class="py-1.5 pr-4">Macro</td>
                  <td class="py-1.5 pr-4">~6.7%</td>
                  <td class="py-1.5 pr-4">—</td>
                  <td class="py-1.5">Distancia al objetivo: |inf − 3| / 3</td>
                </tr>
                <tr>
                  <td class="py-1.5 pr-4 text-(--color-text)">Tasa Banxico real</td>
                  <td class="py-1.5 pr-4">Macro</td>
                  <td class="py-1.5 pr-4">~6.7%</td>
                  <td class="py-1.5 pr-4">—</td>
                  <td class="py-1.5">Distancia al r* neutral: |tasa_real − 2.5%| / 3</td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>

        <!-- Nota técnica -->
        <div class="space-y-2">
          <div class="text-[10px] font-semibold uppercase tracking-[0.12em] text-(--color-text-mute)">Normalización — nota técnica</div>
          <p class="text-sm text-(--color-text-dim) leading-relaxed">
            Para cada serie e indicador, el score en el tiempo <em>t</em> es el <strong class="text-(--color-text)">rango empírico</strong> de x<sub>t</sub> entre todas las observaciones desde el inicio de la serie hasta <em>t</em> (rango relativo acumulado). Esto significa que el score evoluciona conforme se acumula historia: un IMOR de 4% que era "normal" en 2003–2010 puntúa más alto (mayor estrés) en 2024 si la norma reciente ha aumentado. El método es robusto a valores atípicos (basado en rangos, sin supuesto de distribución normal) y consistente con la metodología del Mapa Térmico del sistema financiero mexicano (Banxico, Reporte de Estabilidad Financiera, Recuadro 3, octubre 2018). Para empates, se usa el rango promedio. En series con pocos datos disponibles se retorna 0.5 como valor neutral.
          </p>
        </div>

        <!-- Umbrales de color -->
        <div class="space-y-2">
          <div class="text-[10px] font-semibold uppercase tracking-[0.12em] text-(--color-text-mute)">Umbrales de color</div>
          <div class="overflow-x-auto">
            <table class="table-auto w-full border-collapse text-xs text-(--color-text-dim)">
              <thead>
                <tr class="border-b border-(--color-border)">
